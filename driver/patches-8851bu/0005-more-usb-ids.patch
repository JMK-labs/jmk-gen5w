jmk-wifi 8851bu patch 0005: more RTL8851BU USB IDs

Why: upstream knows 0bda:b851, 3625:010b and 7392:e611 only. Linux's own rtw89 driver
(drivers/net/wireless/realtek/rtw89/rtw8851bu.c, Linux 6.18-7.2) also lists 0bda:b831,
2001:332a (D-Link AX9U rev. A1) and 2c4e:0128 for the same chip; five cars' dongle reports
show 0bda:b831 (2026-11). Only the IDs are taken, as facts; no code. 0bda:b832 is an
RTL8852B and is not added.

diff --git a/os_dep/linux/usb_intf.c b/os_dep/linux/usb_intf.c
index d0564c6..bce954d 100755
--- a/os_dep/linux/usb_intf.c
+++ b/os_dep/linux/usb_intf.c
@@ -228,6 +228,16 @@ static struct usb_device_id rtw_usb_id_tbl[] = {
 
 	/*=== EDIMAX EW-7611UXB ===*/
 	{USB_DEVICE_AND_INTERFACE_INFO(USB_VENDER_ID_EDIMAX, 0xE611, 0xff, 0xff, 0xff), .driver_info = RTL8851B},
+
+	/*
+	 * jmk-wifi: more RTL8851BU dongles, as Linux's own rtw89 rtw8851bu.c lists them
+	 * (Linux 6.18-7.2). 0bda:b831 is also what five cars' dongle reports show
+	 * (2026-11). 0bda:b832 is an RTL8852B and stays there.
+	 */
+	{USB_DEVICE_AND_INTERFACE_INFO(USB_VENDER_ID_REALTEK, 0xB831, 0xff, 0xff, 0xff), .driver_info = RTL8851B},
+	/*=== D-Link AX9U rev. A1 ===*/
+	{USB_DEVICE_AND_INTERFACE_INFO(0x2001, 0x332A, 0xff, 0xff, 0xff), .driver_info = RTL8851B},
+	{USB_DEVICE_AND_INTERFACE_INFO(0x2C4E, 0x0128, 0xff, 0xff, 0xff), .driver_info = RTL8851B},
 #endif /* CONFIG_RTL8851B */
 
 #ifdef CONFIG_RTL8852C
